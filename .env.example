# Riot API
RIOT_API_KEY=your-riot-api-key-here
RIOT_REGION=asia
RIOT_PLATFORM=kr

# LLM Provider - Zhipu GLM
LLM_PROVIDER=zhipu
LLM_DEFAULT_PROVIDER=zhipu
LLM_API_KEY=your-zhipu-api-key-here
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
LLM_MODEL=glm-5.2
LLM_TIMEOUT_SECONDS=30

# PostgreSQL task foundation
# Replace the local-only example password before any non-local deployment.
DATABASE_URL=postgresql+psycopg://riftcoach:riftcoach-local@localhost:5432/riftcoach
DATABASE_POOL_SIZE=5
DATABASE_POOL_TIMEOUT_SECONDS=5

# API safety and bounded task capacity
# Empty means no cross-origin browser access by default.
RIFTCOACH_CORS_ORIGINS=
RIFTCOACH_CORS_ALLOW_CREDENTIALS=false
RIFTCOACH_TASK_OWNER_ACTIVE_LIMIT=3
RIFTCOACH_TASK_GLOBAL_ACTIVE_LIMIT=50
RIFTCOACH_PLAYER_LINK_OWNER_ACTIVE_LIMIT=3
RIFTCOACH_PLAYER_LINK_GLOBAL_ACTIVE_LIMIT=50

# Local API process (the fixed owner is not public authentication)
RIFTCOACH_API_PROFILE=local
RIFTCOACH_LOCAL_OWNER_ID=local-demo-owner
RIFTCOACH_RUNS_ROOT=data/runs

# Production-composed polling Worker
RIFTCOACH_WORKER_ID=worker-1
RIFTCOACH_KNOWLEDGE_ROOT=data/rag_docs
RIFTCOACH_SKILLS_ROOT=skills
RIFTCOACH_PROMPT_PROGRAMS_ROOT=prompt_programs
RIFTCOACH_DDRAGON_CACHE_ROOT=data/static/ddragon
RIFTCOACH_DDRAGON_LANGUAGE=zh_CN
RIFTCOACH_MIN_GAME_DURATION_SECONDS=300
RIFTCOACH_WORKER_INITIAL_DELAY_SECONDS=0.1
RIFTCOACH_WORKER_MAXIMUM_DELAY_SECONDS=2
RIFTCOACH_WORKER_BACKOFF_MULTIPLIER=2
RIFTCOACH_WORKER_JITTER_RATIO=0.2

# Dedicated Account-V1 player-link Worker
RIFTCOACH_PLAYER_LINK_WORKER_ID=player-link-worker-1
RIFTCOACH_RIOT_ALLOWED_ROUTING_REGIONS=americas,asia,europe,sea
RIFTCOACH_RIOT_ACCOUNT_TIMEOUT_SECONDS=15
RIFTCOACH_PLAYER_LINK_WORKER_INITIAL_DELAY_SECONDS=0.1
RIFTCOACH_PLAYER_LINK_WORKER_MAXIMUM_DELAY_SECONDS=2
RIFTCOACH_PLAYER_LINK_WORKER_BACKOFF_MULTIPLIER=2
RIFTCOACH_PLAYER_LINK_WORKER_JITTER_RATIO=0.2
