1b\u7b2c21\u6bb5\u76f4\u63a5\u8bf7\u9605\u8bfb\u8005\u786e\u8ba4\u60f3\u7ec3\u7684\u4f4d\u7f6e\uff1b\u7b2c22\u6bb5\u8981\u6c42\u56fa\u5b9a\u4e2d\u5355\u53ca\u5c0f\u82f1\u96c4\u6c60\u91c7\u6837\u5e76\u8bb0\u5f55\u8bad\u7ec3\u524d\u540e\u8865\u5200/\u5206\u949f\u53d8\u5316\uff1b\u7b2c24\u6bb5\u53c8\u8981\u6c42\u4e0e\u672c\u4eba\u540c\u4f4d\u7f6e\u5386\u53f2\u6837\u672c\u6bd4\u8f83\uff0c\u5e76\u968f\u6837\u672c\u6269\u5927\u8c03\u6574\u3002\u8fd9\u4e00\u8fde\u7eed\u884c\u52a8\u94fe\u5b89\u6392\u7684\u662f\u7ec3\u67d0\u4e2a\u6e38\u620f\u4f4d\u7f6e\u3001\u4f7f\u7528\u56fa\u5b9a\u82f1\u96c4\u6c60\u5e76\u8861\u91cf\u8bad\u7ec3\u524d\u540e\u7684\u6e38\u620f\u6307\u6807\u548c\u4e2a\u4eba\u5386\u53f2\u53c2\u7167\uff0c\u6ca1\u6709\u628a\u884c\u52a8\u5177\u4f53\u9650\u5b9a\u4e3a\u6536\u96c6\u540c\u4e00\u89c2\u6469\u5bf9\u8c61\u7684\u5df2\u5b8c\u6210\u6bd4\u8d5b\u3001\u8bb0\u5f55\u8be5\u5bf9\u8c61\u6307\u6807\u53ca\u6bd4\u8f83\u8be5\u5bf9\u8c61\u5386\u53f2\u3002\u8865\u5200/\u5206\u949f\u662f\u6240\u89c2\u5bdf\u73a9\u5bb6\u7684\u6e38\u620f\u8868\u73b0\uff0c\u4e0d\u80fd\u628a\u9605\u8bfb\u8005\u7684\u89c2\u6469\u7ec3\u4e60\u524d\u540e\u76f4\u63a5\u5f53\u6210\u8be5\u6307\u6807\u7684\u4e2a\u4eba\u8bad\u7ec3\u53d8\u5316\u3002\u8fd9\u91cc\u7684\u5fc5\u8981\u95ee\u9898\u662f\u540e\u7eed\u884c\u52a8\u53ca\u53c2\u7167\u7528\u9014\u4e0e\u89c2\u6469\u4efb\u52a1\u76f8\u51b2\u7a81\uff0c\u4e0d\u662f\u4ec5\u770b\u5230\u7ec3\u4e60\u63aa\u8f9e\u4fbf\u51ed\u7a7a\u8865\u6210\u53e6\u4e00\u4eba\uff1b\u5f00\u5934\u6b63\u786e\u8303\u56f4\u58f0\u660e\u4e0d\u80fd\u6d88\u9664\u540e\u6587\u8981\u6c42\u786e\u8ba4\u8bad\u7ec3\u4f4d\u7f6e\u548c\u91c7\u7528\u672c\u4eba\u8bad\u7ec3\u524d\u540e\u3001\u672c\u4eba\u5386\u53f2\u53c2\u7167\u7684\u5b9e\u9645\u5b89\u6392\u3002\u7b2c23\u6bb5\u8865\u5145\u8f85\u52a9\u6837\u672c\u7684\u539f\u5219\u53ef\u4fdd\u7559\uff0c\u4f46\u4e5f\u5e94\u660e\u786e\u662f\u540c\u4e00\u89c2\u6469\u5bf9\u8c61\u7684\u6837\u672c\u3002\n\n\u672c\u8f6e\u65e2\u6709\u8d44\u6599\u6d88\u8d39\u4e