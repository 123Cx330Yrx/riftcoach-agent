\u50cf\u9a8c\u8bc1\uff0c\u5177\u4f53\u4f53\u73b0\u7edf\u8ba1\u63cf\u8ff0\u3001\u4e8b\u4ef6\u5b9a\u4f4d\u4e0e\u539f\u56e0\u5224\u65ad\u7684\u8bc1\u636e\u5206\u5c42\u3002\u7b2c20\u6bb5\u4ee5[K4]\u7ed9\u51fa\u4ece\u4e94\u5c40\u90091\u81f32\u5c40\u3001\u89c2\u5bdf5\u5206\u949f\u533a\u95f4\u8865\u5200\u8282\u594f\u53ca\u8d44\u6e90\u4e89\u593a\u524d\u540e\u8def\u7ebf\u3001\u8bb0\u5f55\u53d8\u5316\u7684\u5177\u4f53\u89c2\u6469\u52a8\u4f5c\u3001\u5468\u671f\u548c\u590d\u76d8\u65b9\u5f0f\uff0c\u5df2\u628a\u77e5\u8bc6\u8fde\u5230\u884c\u52a8\u3002\u7b2c21\u6bb5\u4ee5[K3]\u4e0d\u8bbe\u65e0\u57fa\u51c6\u56fa\u5b9a\u6570\u503c\u76ee\u6807\u3001\u6269\u5927\u540c\u4f4d\u7f6e\u5386\u53f2\u6bd4\u8f83\uff1b\u7b2c8\u53ca\u7b2c14\u6bb5\u8fd8\u5b9e\u9645\u4f7f\u7528[K1]\u533a\u5206\u65e9\u6b7b\u7ed3\u679c\u3001\u6bd4\u8f83\u8303\u56f4\u53ca\u80fd\u529b\u5224\u65ad\u3002\u6b63\u6587\u81f3\u5c11\u4e00\u5904\u5b9e\u9645\u63d0\u4f9b\u4e14\u652f\u6301\u5efa\u8bae\u7684K\u7f16\u53f7\u8981\u6c42\u5df2\u6ee1\u8db3\uff0c\u5b9e\u9645\u6709\u591a\u5904\uff1b\u4e0d\u80fd\u628a\u5df2\u6709\u5177\u4f53\u884c\u52a8\u8bef\u5224\u4e3a\u4ec5\u5217\u6570\u636e\u3001\u6cdb\u6cdb\u53ef\u7814\u7a76\u6216\u7f3a\u5c11\u77e5\u8bc6\u4f7f\u7528\u3002K1\u81f3K5\u5747\u662f\u6765\u6e90\u4e2d\u771f\u5b9e\u63d0\u4f9b\u7684\u77e5\u8bc6\uff0c\u65b9\u6cd5\u8bed\u4e49\u4e0e\u6211\u5bf9\u6d88\u8d39\u60c5\u51b5\u7684\u89e3\u91ca\u76f8\u7b26\u3002\n\u5916\u90e8\u8d44\u6599\u4e49\u52a1\u5fc5\u987b\u6309\u53ef\u7528\u6027\u89e6\u53d1\u3002\u672c\u6b21external_fact_paths\u4e3a\u7a7a\uff0csource_roots\u5217external_bundle\u4e0d\u53ef\u7528\uff0c\u5168\u90e8\u6765\u6e90\u6ca1\u6709\u53ef\u7528\u4e14\u5339\u914d\u4f4d\u7f6e/\u82f1\u96c4\u7684OP.GG tier/rank/rate\u5feb\u7167\u3002\u7b2c24\u6bb5\u660e\u793a\u672c\u4f1a\u8bdd\u65e0OP.GG\u6570\u636e\uff0c\u56e0\u800c\u4e0d\u542b\u57fa\u4e8e\u5916\u90e8\u5feb\u7167\u7684\u82f1\u96c4\u6c60\u5efa\u8bae\uff0c\u5df2\u7ecf\u4ea4\u4ee3\u8d44\u6599\u7f3a\u53e3\uff1b\u6ca1\u6709\u5fc5\u8981\