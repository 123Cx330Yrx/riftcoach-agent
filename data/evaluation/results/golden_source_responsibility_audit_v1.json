67\u884c\u6027\u300b\uff1b[K5] 02_review_method.md\u300a\u8bc1\u636e\u5206\u5c42\u300b\u3002\n- \u5916\u90e8\u6765\u6e90\uff1aRiot \u5b98\u65b9 16.17 \u8865\u4e01\uff082026-08-25 \u53d1\u5e03\uff09\u4ec5\u652f\u6301\u7248\u672c\u5bf9\u9f50\uff1bOP.GG \u672c\u6b21\u65e0\u53ef\u7528\u4e8b\u5b9e\uff1bData Dragon 16.17.1 \u4ec5\u4f5c\u540d\u79f0\u6620\u5c04\u3002","raw_sha256":"4335abe19f9162f2c00a3ee3f2c0b507a08dfe1d477cd8395e8701dba007a4ca","semantic_approval":false,"version":"source-bound-report-offline-v1"},{"assembled_report":"# RiftCoach \u6559\u7ec3\u5f0f\u590d\u76d8\u62a5\u544a\n\n> \u89c2\u6469\u5bf9\u8c61\uff1aDK ShowMaker#KR1\uff085 \u5c40\u6392\u4f4d\uff0c\u961f\u5217 420\uff0c\u6837\u672c\u65f6\u95f4\u7531 Riot API \u8fd4\u56de\uff09\u3002\u672c\u62a5\u544a\u4e3a\u5bf9\u8be5\u5bf9\u8c61\u8fd1\u671f\u6bd4\u8d5b\u7684\u89c2\u6469\u590d\u76d8\uff0c\u4e0d\u4ee3\u8868\u9605\u8bfb\u8005\u672c\u4eba\u7684\u80fd\u529b\u57fa\u7ebf\u6216\u8bad\u7ec3\u4f9d\u636e\u3002\n\n## 1. \u603b\u4f53\u7ed3\u8bba\n\n- \u6837\u672c 5 \u5c40\uff0c2 \u80dc 3 \u8d1f\uff0840.0%\uff09\u3002\u4e2d\u5355 4 \u5c40 2 \u80dc 2 \u8d1f\uff0c\u8f85\u52a9 1 \u5c40 0 \u80dc 1 \u8d1f\uff1b\u8bad\u7ec3\u76ee\u6807\u672a\u6307\u5b9a\uff0c\u672c\u62a5\u544a\u4e0d\u5047\u5b9a\u5176\u4e3b\u4f4d\u7f6e\u3002\n- \u4e24\u9879\u4e3b\u8981\u89c2\u5bdf\uff1a\u2460 \u552f\u4e00\u8f85\u52a9\u5c40\uff08\u5361\u871c\u5c14\uff0913 \u6b7b\u300115 \u5206\u949f\u524d\u6b7b\u4ea1 7 \u6b21\uff0c\u662f\u6574\u4f53\u5747\u503c\u7684\u4e3b\u8981\u62c9\u52a8\u9879\uff1b\u2461 \u4ec5\u770b\u4e2d\u5355\u5185\u90e8\uff0c\u8f93\u5c40\u7684\u4f24\u5bb3/\u5206\u949f\uff08617.52\uff09\u8fdc\u4f4e\u4e8e\u8d62\u5c40\uff081286.76\uff09\uff0c\u800c\u8865\u5200/\u5206\u949f\u4e24\u8005\u63a5\u8fd1\uff089.01 vs 8.805\uff09\u3002\u4f24\u5bb3\u4e0b\u964d\u53ef\u80fd\u4e0e\u7ecf\u6d4e\u3001\u53c2\u56e2\u73af\u5883\u6216\u9635\u5bb9\u804c\u8d23\u5171\u540c\u53d8\u5316\u6709\u5173\uff0c\u7edf\u8ba1\u6570\u636e\u53ea\u80fd\u8bf4\u660e\u5171\u540c\u53d8\u5316\uff0c\u4e0d\u80fd\u8bc1\u660e\u56e0\u679c [K2]\u3002\n\n## 2. \u5f53\u524d\u8868\u73b0\u4eae\u70b9\n\n- \u4e2d\u5355\u8d62\u5c40\u8d28\u91cf\u8f83\u9ad8\uff1a\u8f9b\u5fb7\u62c9 14/5/10\u3001\u4f24\u5bb3/\u5206\u949f 1430.11\uff1b\u8587\u53e4\u4e1d 8/5/23\u3001KDA 6.2\u3001\u53c2\u56e2 77.5%\u3002\n- 4 \u5c40\u4e2d\u5355\u7684\u8865\u5200/\u5206\u949f\u5747\u503c\u7ea6 8.91\uff0c5 \u5c40\u91cc\u6700\u4f4e\u7684\u4e2d\u5355\u5c40\u4e5f\u6709 8.38\uff0c\u8865\u5200\u7a33\u5b9a\u662f\u8be5\u6837\u672c\u7684\u76f8\u5bf9\u5f3a\u9879\uff08\u4ec5\u63cf\u8ff0\u672c\u6b21 5 \u5c40\uff09\u3002\n\n## 3. \u4e3b\u8981\u98ce\u9669\u70b9\n\n- **\u8f85\u52a9\u5361\u871c\u5c14\u5c40\uff08KR_8370293236\uff09**\uff1a26 \u5206\u949f\u5185 1/13/11\uff0c15 \u5206\u949f\u524d\u6b7b\u4ea1 7 \u6b21\uff0c\u8865\u5200/\u5206\u949f 1.34\u3002\u8fd9\u662f\u4e8b\u5b9e\u63cf\u8ff0\uff1b\u539f\u56e0\uff08\u6362\u8840\u3001\u8d70\u4f4d\u3001\u51b3\u7b56\uff09\u9700\u5f55\u50cf\u6838\u5bf9 [K5]\u3002\u8be5\u5c40\u628a\u6df7\u5408\u6837\u672c\u7684 15 \u5206\u949f\u524d\u6b7b\u4ea1\u5747\u503c\u62c9\u5230 2.6\uff1b\u4ec5\u4e2d\u5355\u6837\u672c\u8be5\u503c\u7ea6 1.5\u3002\n- **\u4e2d\u5355\u8f93\u5c40\u7684\u4f24\u5bb3\u8f93\u51fa\u65ad\u5c42**\uff1a\u8f93\u5c40 617.52 vs \u8d62\u5c40 1286.76\uff08\u7ea6\u51cf\u534a\uff09\uff0c\u4f46\u8865\u5200/\u5206\u949f\u53cd\u800c\u7565\u9ad8\u3001\u7ecf\u6d4e/\u5206\u949f 432.82 vs 505.29 \u5dee\u8ddd\u4e0d\u5927\u3002\u6309\u4f4d\u7f6e\u4e0e\u6837\u672c\u4e00\u81f4\u53e3\u5f84\u6bd4\u8f83\uff0c\u8fd9\u66f4\u63a5\u8fd1\"\u4f24\u5bb3\u8f6c\u5316/\u53c2\u56e2\u73af\u5883\"\u95ee\u9898\uff0c\u800c\u975e\u8865\u5200\u95ee\u9898 [K2]\u3002\n\n## 4. \u8d62\u5c40\u4e0e\u8f93\u5c40\u5dee\u5f02\n\n| \u6307\u6807\uff08\u4e2d\u5355 2 \u80dc 2 \u8d1f\u53e3\u5f84\uff09 | \u8d62\u5c40\u5747\u503c | \u8f93\u5c40\u5747\u503c |\n|---|---:|---:|\n| \u4f24\u5bb3/\u5206\u949f | 1286.76 | 617.52 |\n| \u7ecf\u6d4e/\u5206\u949f | 505.29 | 432.82 |\n| \u8865\u5200/\u5206\u949f | 8.81 | 9.01 |\n| \u89c6\u91ce\u5206 | 33.5 | 34.0 |\n\n\u6df7\u5408 5 \u5c40\u53e3\u5f84\u4e0b\u8865\u5200\u5dee\u5f02\uff088.8 vs 6.45\uff09\u4e3b\u8981\u7531\u8f85\u52a9\u5c40\u6784\u6210\u9020\u6210\uff0c\u4e0d\u80fd\u89e3\u91ca\u4e3a\u4e2d\u5355\u4f4d\u7f6e\u7684\u8865\u5200\u5dee\u8ddd\u300215 \u5206\u949f\u524d\u6b7b\u4ea1\uff1a\u8d62 2.5 / \u8f93 2.67\uff08\u6df7\u5408\u53e3\u5f84\uff09\uff0c\u5dee\u5f02\u5f88\u5c0f\uff0c\u4e0d\u5b9c\u5217\u4e3a\u4e3b\u8981\u80dc\u8d1f\u5206\u754c\u70b9 [K1]\u3002\n\n## 5. \u4e0b\u4e00\u6b65\u590d\u76d8\u5efa\u8bae\n\n1. \u9010\u5c40\u6807\u8bb0\u6b7b\u4ea1\u65f6\u95f4\uff0c\u91cd\u70b9\u6838\u5bf9\u5361\u871c\u5c14\u5c40 03:26\u201313:24 \u7684\u8fde\u7eed\u6b7b\u4ea1\u4e0e\u4e24\u5c40\u4e2d\u5355\u80dc\u5c40\u7684\u4f24\u5bb3\u6765\u6e90\uff08\u6362\u8840\u8fd8\u662f\u56e2\u6218\uff09[K4][K5]\u3002\n2. \u5bf9\u4e24\u5c40\u4e2d\u5355\u8f93\u5c40\uff0c\u6bd4\u8f83\u76ee\u6807\u8d44\u6e90\uff08\u5c0f\u9f99\u3001\u5148\u950b\uff09\u524d\u540e\u7684\u6d3b\u52a8\u8def\u7ebf\uff0c\u68c0\u9a8c\u4f24\u5bb3\u4e0b\u964d\u662f\u5426\u6e90\u4e8e\u53c2\u56e2\u73af\u5883\u53d8\u5316 [K4]\u3002\n3. OP.GG \u6570\u636e\u7f3a\u53e3\uff1a\u672c\u6b21\u63d0\u4f9b\u7684\u5916\u90e8\u6765\u6e90\u4e2d OP.GG \u5143\u6570\u636e\u5df2\u8fc7\u671f\u3001\u4e24\u6761\u8bb0\u5f55\u6807\u8bb0\u4e3a\u4e0d\u53ef\u7528\uff08\u68c0\u7d22\u65f6\u95f4 2026-09-10\uff0c\u8303\u56f4\u4ec5\u5f53\u524d\u5feb\u7167\uff09\uff0c\u65e0\u6cd5\u7ed9\u51fa\u4f4d\u7f6e\u00d7\u82f1\u96c4\u7684\u5206\u7ea7/\u51fa\u573a\u7387\u5bf9\u7167\u3002\u82e5\u9700\u8981\u5916\u90e8\u5bf9\u7167\uff0c\u5efa\u8bae\u63d0\u4f9b\u5339\u914d\u5176\u8bad\u7ec3\u4f4d\u7f6e\u4e0e\u82f1\u96c4\u7684\u53ef\u7528\u5feb\u7167\u540e\u518d\u770b\uff1b\u7f3a\u5931\u662f\u6570\u636e\u8fb9\u754c\uff0c\u4e0d\u4ee3\u8868\u8868\u73b0\u95ee\u9898\u3002\n4. \u7248\u672c\u5bf9\u9f50\uff1a\u5bf9\u5c40\u7248\u672c 16.17\uff08\u5b98\u65b9\u53d1\u5e03\u65f6\u95f4 2026-08-25\uff0c\u4ec5\u7528\u4e8e\u7248\u672c\u5bf9\u9f50\uff0c\u4e0d\u636e\u6b64\u5224\u65ad\u82f1\u96c4\u5f3a\u5f31\uff09\uff1b\u540d\u79f0\u6620\u5c04\u6765\u81ea Data Dragon 16.17.1\u3002\n\n## 6. \u8bad\u7ec3\u8ba1\u5212\n\n\u8bad\u7ec3\u76ee\u6807\u672a\u6307\u5b9a\uff08goal_source \u4e3a\u672a\u6307\u5b9a\u3001\u8bad\u7ec3\u4f4d\u7f6e\u4e3a\u7a7a\uff09\uff0c\u56e0\u6b64\u4e0d\u8bbe\u5b9a\u56fa\u5b9a\u4f4d\u7f6e\u8ba1\u5212\uff1b\u4ee5\u4e0b\u4e3a\u6761\u4ef6\u9009\u9879\uff0c\u8bf7\u786e\u8ba4\u60f3\u8bad\u7ec3\u7684\u4f4d\u7f6e\uff1a\n\n- **\u82e5\u9009\u62e9\u8bad\u7ec3\u4e2d\u8def**\uff1a\u4ee5\"\u8f93\u5c40\u4f24\u5bb3/\u5206\u949f\u56de\u5347\"\u4e3a\u53ef\u89c2\u5bdf\u76ee\u6807\uff0c\u56fa\u5b9a 1\u20132 \u4e2a\u4e2d\u5355\u82f1\u96c4\u8fde\u7eed\u91c7\u6837 5 \u5c40\uff0c\u9010\u5c40\u8bb0\u5f55\u6b7b\u4ea1\u65f6\u95f4\u4e0e\u53c2\u56e2\u8def\u7ebf\uff1b\u4e0d\u8bbe\u8865\u5200/\u4f24\u5bb3\u7684\u56fa\u5b9a\u9608\u503c\uff0c\u5148\u4e0e\u8be5\u4f4d\u7f6e\u81ea\u5df1\u7684\u5386\u53f2\u6837\u672c\u6bd4\u8f83\uff0c\u6837\u672c\u6269\u5927\u540e\u518d\u8c03\u6574 [K3][K4]\u3002\n- **\u82e5\u9009\u62e9\u8bad\u7ec3\u8f85\u52a9**\uff1a\u76ee\u524d\u4ec5 1 \u5c40\u6837\u672c\uff08\u4e14\u4e3a\u975e\u5e38\u89c4\u82f1\u96c4\u9009\u62e9\uff09\uff0c\u6837\u672c\u4e0d\u8db3\u4ee5\u8bc4\u4ef7\u8be5\u4f4d\u7f6e\u8868\u73b0\uff1b\u5efa\u8bae\u5148\u8865 3\u20135 \u5c40\u8f85\u52a9\u6837\u672c\u518d\u5b9a\u76ee\u6807 [K3]\u3002\n\n## 7. \u6570\u636e\u8fb9\u754c\u4e0e\u77e5\u8bc6\u6765\u6e90\n\n- \u672c\u62a5\u544a\u4ec5\u63cf\u8ff0 Riot API \u63d0\u4f9b\u7684 5 \u5c40\u9009\u5b9a\u6bd4\u8d5b\uff0c\u4e0d\u5916\u63a8\u957f\u671f\u6c34\u5e73\u3001\u672a\u6765\u5bf9\u5c40\u6216\u56e0\u679c\uff1b\u89c2\u6469\u5bf9\u8c61\u4e0d\u662f\u9605\u8bfb\u8005\u672c\u4eba\uff0c\u6240\u6709\u8bad\u7ec3\u5efa\u8bae\u4ec5\u4e3a\u89c2\u6469\u6027\u6761\u4ef6\u9009\u9879\u3002\n- \u6df7\u5408\u4f4d\u7f6e\u5747\u503c\u53d7\u4f4d\u7f6e\u6784\u6210\u5f71\u54cd\uff0c\u6240\u6709\u4f4d\u7f6e\u76f8\u5173\u7ed3\u8bba\u5df2\u6309\